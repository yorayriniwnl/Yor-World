+.stageContainer {
+  position: relative;
+  width: 100%;
+  height: 640px;
+  min-height: 480px;
+  max-height: 80vh;
+  margin: 1.5rem 0 2rem;
+  background-color: #0c1017;
+  border-radius: var(--radius-md, 8px);
+  overflow: hidden;
+  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
+}
+
+.canvas {
+  display: block;
+  width: 100%;
+  height: 100%;
+}
+
+.hudOverlay {
+  position: absolute;
+  top: 1rem;
+  left: 1rem;
+  right: 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+  pointer-events: none;
+  z-index: 10;
+}
+
+.hudTopBar {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  pointer-events: auto;
+}
+
+.hudControls {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem;
+  padding: 0.75rem 1rem;
+  background: rgba(12, 16, 23, 0.85);
+  backdrop-filter: blur(8px);
+  border: 1px solid rgba(255, 255, 255, 0.12);
+  border-radius: 6px;
+  pointer-events: auto;
+}
+
+.hudButton {
+  min-height: 44px;
+  min-width: 44px;
+  padding: 0.5rem 0.875rem;
+  font-family: inherit;
+  font-size: 0.875rem;
+  font-weight: 500;
+  color: #fbfaf7;
+  background-color: rgba(255, 255, 255, 0.08);
+  border: 1px solid rgba(255, 255, 255, 0.2);
+  border-radius: 4px;
+  cursor: pointer;
+  transition: background-color 0.15s ease, border-color 0.15s ease;
+}
+
+.hudButton:hover {
+  background-color: rgba(255, 255, 255, 0.18);
+  border-color: rgba(255, 255, 255, 0.4);
+}
+
+.hudButton:focus-visible {
+  outline: 3px solid #174bbb;
+  outline-offset: 2px;
+}
+
+.hudButtonActive {
+  background-color: #174bbb;
+  border-color: #3b74f2;
+  color: #ffffff;
+}
+
+.statusBadge {
+  padding: 0.4rem 0.75rem;
+  font-size: 0.8125rem;
+  font-family: var(--font-mono, monospace);
+  background: rgba(0, 0, 0, 0.7);
+  color: #78e4ff;
+  border: 1px solid rgba(120, 228, 255, 0.3);
+  border-radius: 4px;
+}
+
+.diagnosticsDrawer {
+  max-width: 420px;
+  padding: 0.75rem;
+  font-family: var(--font-mono, monospace);
+  font-size: 0.75rem;
+  line-height: 1.4;
+  color: #cadbee;
+  background: rgba(8, 12, 18, 0.92);
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  border-radius: 6px;
+  pointer-events: auto;
+}
+
+.fallbackBanner {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  padding: 2rem;
+  background: #f0f4f9;
+  border: 2px solid #cedae8;
+  border-radius: 8px;
+  color: #172c42;
+  margin: 1.5rem 0;
+}
+
+.fallbackTitle {
+  margin: 0;
+  font-size: 1.25rem;
+  color: #0f1c2b;
+}
+
+.fallbackDescription {
+  margin: 0;
+  line-height: 1.5;
+  color: #43546d;
+}
+
+.fallbackActions {
+  display: flex;
+  gap: 0.75rem;
+  flex-wrap: wrap;
+}
+
+@media (max-width: 640px) {
+  .stageContainer {
+    height: 520px;
+  }
+  .hudControls {
+    padding: 0.5rem;
+    gap: 0.375rem;
+  }
+  .hudButton {
+    min-height: 44px;
+    padding: 0.4rem 0.6rem;
+    font-size: 0.8125rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hudButton {
+    transition: none;
+  }
+}
diff --git a/deliveries/G1/source/tests/e2e/browser-behavior.spec.ts b/deliveries/G1/source/tests/e2e/browser-behavior.spec.ts
