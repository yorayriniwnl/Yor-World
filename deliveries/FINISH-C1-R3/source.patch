+    expect(lm.startEntrance(oldToken)).toBe(false);
+    expect(lm.updateLoadingProgress(oldToken, {
+      session: oldSession,
+      stage: "stale",
+      bytes: { kind: "determinate", scope: "required-session", loaded: 1, total: 2 },
