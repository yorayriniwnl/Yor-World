+    await expect.poll(() => wallpaperLoaded).toBe(true);
+    await quality.selectOption("high");
+    await expect(stage).toHaveAttribute("data-lifecycle-state", "HOME");
+    expect(browserErrors).toEqual([]);
+    await expect.poll(async () => page.evaluate(() => {
