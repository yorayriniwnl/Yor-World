+def json_file(path: Path, label: str) -> dict[str, Any]:
+    return json_from_bytes(path.read_bytes(), label)
+
+
+def validate_installed_three_package(
+    package_root: Path, package_root_relative: str, dependency_evidence: dict[str, Any]
+) -> dict[str, Any]:
+    package_info = json_from_bytes((package_root / "package.json").read_bytes(), "installed three/package.json")
+    require(package_info.get("name") == "three", "installed package is not named three")
+    require(package_info.get("version") == EXPECTED_THREE_VERSION, "installed Three.js version is not 0.180.0")
+    require(dependency_evidence.get("packageName") == package_info["name"], "source binding package name differs from installed package")
+    require(dependency_evidence.get("packageVersion") == package_info["version"], "source binding package version differs from installed package")
+    require(dependency_evidence.get("installedPackageRoot") == package_root_relative, "source binding package root differs from installed package")
+    package_file_rows = dependency_evidence.get("packageFiles")
+    package_file_aliases = validate_unique_rows(package_file_rows, "alias", len(EXPECTED_THREE_PACKAGE_FILES), "source-binding packageFiles")
+    expected_package_aliases = {row["alias"] for row in EXPECTED_THREE_PACKAGE_FILES}
+    require(package_file_aliases == expected_package_aliases, "source-binding packageFiles aliases differ from the pinned Three.js files")
+    package_file_paths = [row.get("packageFile") for row in package_file_rows]
+    require(all(isinstance(path, str) and path for path in package_file_paths), "source-binding packageFiles contains a malformed packageFile")
+    require(len(package_file_paths) == len(set(package_file_paths)), "source-binding packageFiles contains duplicate packageFile paths")
+    package_rows_by_alias = {row["alias"]: row for row in package_file_rows}
+    for expected_row in EXPECTED_THREE_PACKAGE_FILES:
+        alias = expected_row["alias"]
+        row = package_rows_by_alias[alias]
+        require(set(row) == set(expected_row), f"source-binding {alias} fields are missing or extra")
+        require(row == expected_row, f"source-binding {alias} declaration differs from the authoritative R7 package receipt")
+        installed_path = package_root / expected_row["packageFile"]
+        try:
+            installed_data = installed_path.read_bytes()
+        except OSError as error:
+            raise VerificationError(f"installed Three.js package file is unavailable for {alias}: {error}") from error
+        installed_sha256 = hashlib.sha256(installed_data).hexdigest()
+        require(installed_sha256 == expected_row["sha256"], f"installed Three.js bytes differ for {alias}")
+        require(len(installed_data) == expected_row["bytes"], f"installed Three.js byte count differs for {alias}")
+    return package_info
