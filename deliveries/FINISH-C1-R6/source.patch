+  it("restores the required-session aggregate when a failed compressed attempt is replaced by an identity retry", async () => {
+    vi.stubGlobal("window", {});
+    harness.failAtParse = 1;
+    let roomAttempts = 0;
+    const fetchMock = vi.fn(async (input: RequestInfo | URL) => {
+      const url = String(input);
+      if (url.endsWith("production-room-full.glb")) {
+        roomAttempts += 1;
+        const headers = roomAttempts === 1
+          ? { "content-length": "4", "content-encoding": "gzip" }
+          : { "content-length": "4", "content-encoding": "identity" };
+        return new Response(new Uint8Array([1, 2, 3, 4]), { headers });
+      }
+      return new Response(new Uint8Array([1, 2, 3, 4]), {
+        headers: { "content-length": "4", "content-encoding": "identity" },
+      });
+    });
+    vi.stubGlobal("fetch", fetchMock);
+
+    const abort = new AbortController();
+    const optionalAbort = new AbortController();
+    optionalAbort.abort();
+    const progress: Array<{
+      stage: string;
+      requiredLoaded: number;
+      bytes: { kind: string; loaded?: number; total?: number; reason?: string };
+    }> = [];
+    const result = await new AssetLoader("compressed-retry-aggregate-test").loadSession({
+      sessionToken: 15,
+      sessionGeneration: 150,
+      signal: abort.signal,
+      optionalSignal: optionalAbort.signal,
+      onProgress: (entry) => progress.push(entry),
+      onOptionalConsumer: () => "rejected",
+    });
+
+    expect(roomAttempts).toBe(2);
+    expect(harness.parsed).toBe(4);
+    expect(progress.some((entry) => entry.stage.startsWith("Retrying production-room-full.glb"))).toBe(true);
+    expect(progress.at(-1)).toMatchObject({
+      stage: "All required assets decoded",
+      requiredLoaded: 3,
+      bytes: { kind: "determinate", scope: "required-session", loaded: 12, total: 12 },
+    });
     abort.abort();
     result.resourceLedger?.dispose();
   });
