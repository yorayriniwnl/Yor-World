+    // Still paused after greeting returns to coding
+    expect(director.isDecorativePaused).toBe(true);
+    director.advance(1.0);
+    expect(director.currentTime).toBe(0);
+
+    // Resume
+    director.setDecorativePaused(false);
+    director.advance(1.0);
