+
+def _mesh_world_bounds(objects):
+    points = []
+    for obj in objects:
+        for vertex in obj.data.vertices:
+            points.append(obj.matrix_world @ vertex.co)
+    if not points:
+        return None
+    return {
+        "min": [min(point[i] for point in points) for i in range(3)],
+        "max": [max(point[i] for point in points) for i in range(3)],
+    }
+
+
+def _inside_object_tree(obj, root):
+    node = obj
+    while node is not None:
+        if node == root:
+            return True
+        node = node.parent
+    return False
+
+
+def _static_batch_skip_reason(obj):
+    if obj.name in STATIC_BATCH_EXACT_EXCLUSIONS:
+        return "contract-target-or-mutable-surface"
+    if obj.name.startswith("blind_slat_"):
+        return "independently-moving-window-blind"
+    node = obj.parent
+    while node is not None:
+        if node.name in STATIC_BATCH_PIVOT_EXCLUSIONS:
+            return f"descendant-of-moving-hook:{node.name}"
+        node = node.parent
+    if obj.children:
+        return "mesh-parent-with-descendants"
+    if obj.animation_data is not None:
+        return "animated-object"
+    if len(obj.data.materials) != 1 or obj.data.materials[0] is None:
+        return "not-one-material"
+    if obj.data.users != 1:
+        return "shared-mesh-data"
+    if obj.data.shape_keys or obj.vertex_groups or obj.modifiers:
+        return "deformed-or-modified-mesh"
+    if obj.hide_render:
+        return "hidden-render-object"
+    return None
+
+
+def batch_static_meshes(asset_root, output_parent=None, parent_local=False):
+    """Merge safe static geometry by material; retain original named TRS anchors."""
+    output_parent = output_parent or asset_root
+    candidates = []
+    for obj in list(bpy.data.objects):
+        if obj.type != "MESH" or not _inside_object_tree(obj, asset_root):
+            continue
+        reason = _static_batch_skip_reason(obj)
+        if reason:
+            STATIC_BATCH_SKIPS.append({"assetRoot": asset_root.name, "name": obj.name, "reason": reason})
+            continue
+        candidates.append(obj)
+
+    groups = {}
+    for obj in candidates:
+        material = obj.data.materials[0]
+        if parent_local or obj.parent and obj.parent.name in STATIC_BATCH_SPECIAL_PARENTS:
+            batch_parent = obj.parent or output_parent
+        else:
+            batch_parent = output_parent
+        key = (batch_parent.name, material.name)
+        groups.setdefault(key, {"parent": batch_parent, "material": material, "objects": []})["objects"].append(obj)
+
+    for key in sorted(groups):
+        group = groups[key]
+        source_objects = sorted(group["objects"], key=lambda item: item.name)
+        if len(source_objects) < 2:
+            continue
+        parent = group["parent"]
+        material = group["material"]
+        source_bounds = _mesh_world_bounds(source_objects)
+        source_vertices = sum(len(obj.data.vertices) for obj in source_objects)
+        source_faces = sum(len(obj.data.polygons) for obj in source_objects)
+        source_records = []
+        for obj in source_objects:
+            source_records.append({
+                "name": obj.name,
+                "parent": obj.parent.name if obj.parent else None,
+                "matrixBasis": [list(row) for row in obj.matrix_basis],
+                "matrixParentInverse": [list(row) for row in obj.matrix_parent_inverse],
+                "customProperties": {name: obj[name] for name in obj.keys() if name != "_RNA_UI"},
+                "collections": list(obj.users_collection),
+            })
+
+        if bpy.context.object and bpy.context.object.mode != "OBJECT":
+            bpy.ops.object.mode_set(mode="OBJECT")
+        bpy.ops.object.select_all(action="DESELECT")
+        for obj in source_objects:
+            obj.select_set(True)
+        active = source_objects[0]
+        bpy.context.view_layer.objects.active = active
+        bpy.context.view_layer.update()
+        if "FINISHED" not in bpy.ops.object.join():
+            raise RuntimeError(f"Static batch join failed for {key}")
+
+        # Join retains the active object's object transform. Move the combined
+        # vertices into the chosen output parent space before resetting its TRS.
+        bpy.context.view_layer.update()
+        parent_inverse = parent.matrix_world.inverted_safe()
+        batch_to_parent = parent_inverse @ active.matrix_world.copy()
+        active.data.transform(batch_to_parent)
+        batch_name = f"StaticBatch__{parent.name}__{material.name}"
+        active.name = batch_name
+        active.data.name = batch_name
+        active.parent = parent
+        active.matrix_parent_inverse = mathutils.Matrix.Identity(4)
+        active.matrix_basis = mathutils.Matrix.Identity(4)
+        bpy.context.view_layer.update()
+
+        # Recreate every source node as a non-rendering semantic anchor. Their
+        # parent, parent inverse, local transform and custom properties survive.
+        for record in source_records:
+            anchor = bpy.data.objects.new(record["name"], None)
+            for collection in record["collections"]:
+                collection.objects.link(anchor)
+            anchor.parent = bpy.data.objects.get(record["parent"]) if record["parent"] else None
+            anchor.matrix_parent_inverse = mathutils.Matrix(record["matrixParentInverse"])
+            anchor.matrix_basis = mathutils.Matrix(record["matrixBasis"])
+            anchor.empty_display_type = "PLAIN_AXES"
+            for prop, value in record["customProperties"].items():
+                anchor[prop] = value
+
+        joined_bounds = _mesh_world_bounds([active])
+        joined_vertices = len(active.data.vertices)
+        joined_faces = len(active.data.polygons)
+        deltas = [
+            abs(source_bounds[edge][axis] - joined_bounds[edge][axis])
+            for edge in ("min", "max") for axis in range(3)
+        ]
+        max_bound_delta = max(deltas)
+        geometry_status = "PASS" if (
+            joined_vertices == source_vertices and joined_faces == source_faces and max_bound_delta <= 1e-5
+        ) else "FAIL"
+        result = {
+            "assetRoot": asset_root.name,
+            "batchParent": parent.name,
+            "batchName": active.name,
+            "material": material.name,
+            "sourceMeshCount": len(source_records),
+            "sourceNames": [record["name"] for record in source_records],
+            "sourceVertices": source_vertices,
+            "joinedVertices": joined_vertices,
+            "sourceFaces": source_faces,
+            "joinedFaces": joined_faces,
+            "sourceWorldBounds": source_bounds,
+            "joinedWorldBounds": joined_bounds,
+            "maxWorldBoundsDelta": max_bound_delta,
+            "geometryPreservation": geometry_status,
+        }
+        STATIC_BATCH_RESULTS.append(result)
+        if geometry_status != "PASS":
+            raise RuntimeError(f"Static batch changed geometry: {json.dumps(result)}")
+
+    return {"assetRoot": asset_root.name, "candidateMeshCount": len(candidates), "batchCount": sum(1 for item in STATIC_BATCH_RESULTS if item["assetRoot"] == asset_root.name)}
 
