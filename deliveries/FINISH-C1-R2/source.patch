diff --git "a/app/src/features/world/asset-resources.tsdeliveries/FINISH-C1-R2\\source/src/features/world/asset-resources.ts" "b/app/src/features/world/asset-resources.tsdeliveries/FINISH-C1-R2\\source/src/features/world/asset-resources.ts"
