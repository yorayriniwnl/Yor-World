diff --git a/app/src/features/world/world.module.css b/app/src/features/world/world.module.css
index 1564deeb..b9e39027 100644
--- a/app/src/features/world/world.module.css
+++ b/app/src/features/world/world.module.css
@@ -98,6 +98,29 @@
   outline-offset: 2px;
 }
 
+@media (min-width: 900px) and (min-height: 600px) {
+  .studioPortfolioNav {
+    top: max(4.25rem, calc(env(safe-area-inset-top) + 4rem));
+    right: max(0.75rem, env(safe-area-inset-right));
+    bottom: auto;
+    left: auto;
+    flex-direction: column;
+    align-items: stretch;
+    justify-content: flex-start;
+    box-sizing: border-box;
+    width: 8.75rem;
+    max-width: calc(100% - 1.5rem);
+    margin: 0;
+    overflow: visible;
+  }
+
+  .studioPortfolioNav a,
+  .studioPortfolioNav button {
+    box-sizing: border-box;
+    width: 100%;
+  }
+}
+
 .canvas {
   display: block;
   width: 100%;
