# Client-safe; required for the authorized G7 production environment.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; required for durable PostgreSQL transactions and owner services.
# Use the Supabase PostgreSQL connection appropriate to the hosting runtime.
DATABASE_URL=
CONTACT_HASH_SECRET=
QUOTA_HASH_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_PRIVATE_BUCKET=

# Server-only; required for the mail outbox worker.
RESEND_API_KEY=
MAIL_FROM=
OWNER_NOTIFICATION_EMAIL=

# Server-only; configure one high-entropy internal job credential.
CRON_SECRET=
# INTERNAL_JOB_KEY=

# Server-only; optional GitHub API authentication.
GITHUB_TOKEN=

# Compatibility aliases are server-only; prefer the names above.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# Explicit isolated local E2E configuration only. Never set on a hosted app.
# YOR_E2E_FIXTURE=1
# YOR_TEST_DATABASE_PATH=
