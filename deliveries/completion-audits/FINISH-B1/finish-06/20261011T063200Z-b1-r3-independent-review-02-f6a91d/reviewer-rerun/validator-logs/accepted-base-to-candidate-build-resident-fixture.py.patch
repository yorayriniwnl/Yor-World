+# FINISH-B1-R3: static fixture batches reduce the chair's many primitive draws
+# while preserving the animated chair-root and exact Chair_Seat contact mesh.
+def _fixture_inside_tree(obj, root):
+    node = obj
+    while node is not None:
+        if node == root:
+            return True
+        node = node.parent
+    return False
+
+def _fixture_bounds(objects):
+    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
+    if not points:
+        return None
+    return {
+        "min": [min(point[i] for point in points) for i in range(3)],
+        "max": [max(point[i] for point in points) for i in range(3)],
+    }
+
+fixture_batch_results = []
+def batch_fixture_root(root, exclusions):
+    candidates = []
+    for obj in list(bpy.data.objects):
+        if obj.type != "MESH" or not _fixture_inside_tree(obj, root):
+            continue
+        if (obj.name in exclusions or obj.children or obj.animation_data is not None
+                or len(obj.data.materials) != 1 or obj.data.materials[0] is None
+                or obj.data.users != 1 or obj.data.shape_keys or obj.vertex_groups
+                or obj.modifiers or obj.hide_render):
+            continue
+        candidates.append(obj)
+
+    groups = {}
+    for obj in candidates:
+        groups.setdefault((obj.parent.name if obj.parent else root.name, obj.data.materials[0].name), []).append(obj)
+
+    results = []
+    for (parent_name, material_name), source_objects in sorted(groups.items()):
+        if len(source_objects) < 2:
+            continue
+        source_objects = sorted(source_objects, key=lambda item: item.name)
+        parent = bpy.data.objects.get(parent_name) or root
+        material = bpy.data.materials.get(material_name)
+        source_bounds = _fixture_bounds(source_objects)
+        source_vertices = sum(len(obj.data.vertices) for obj in source_objects)
+        source_faces = sum(len(obj.data.polygons) for obj in source_objects)
+        source_records = [{
+            "name": obj.name,
+            "parent": obj.parent.name if obj.parent else None,
+            "matrixBasis": [list(row) for row in obj.matrix_basis],
+            "matrixParentInverse": [list(row) for row in obj.matrix_parent_inverse],
+            "customProperties": {name: obj[name] for name in obj.keys() if name != "_RNA_UI"},
+            "collections": list(obj.users_collection),
+        } for obj in source_objects]
+
+        if bpy.context.object and bpy.context.object.mode != "OBJECT":
+            bpy.ops.object.mode_set(mode="OBJECT")
+        bpy.ops.object.select_all(action="DESELECT")
+        for obj in source_objects:
+            obj.select_set(True)
+        active = source_objects[0]
+        bpy.context.view_layer.objects.active = active
+        bpy.context.view_layer.update()
+        if "FINISHED" not in bpy.ops.object.join():
+            raise RuntimeError(f"Fixture static batch join failed for {root.name}/{parent_name}/{material_name}")
+
+        bpy.context.view_layer.update()
+        active.data.transform(parent.matrix_world.inverted_safe() @ active.matrix_world.copy())
+        batch_name = f"StaticBatch__{root.name}__{material_name}"
+        active.name = batch_name
+        active.data.name = batch_name
+        active.parent = parent
+        active.matrix_parent_inverse = Matrix.Identity(4)
+        active.matrix_basis = Matrix.Identity(4)
+        bpy.context.view_layer.update()
+
+        for record in source_records:
+            anchor = bpy.data.objects.new(record["name"], None)
+            for collection in record["collections"]:
+                collection.objects.link(anchor)
+            anchor.parent = bpy.data.objects.get(record["parent"]) if record["parent"] else None
+            anchor.matrix_parent_inverse = Matrix(record["matrixParentInverse"])
+            anchor.matrix_basis = Matrix(record["matrixBasis"])
+            anchor.empty_display_type = "PLAIN_AXES"
+            for prop, value in record["customProperties"].items():
+                anchor[prop] = value
+
+        joined_bounds = _fixture_bounds([active])
+        joined_vertices = len(active.data.vertices)
+        joined_faces = len(active.data.polygons)
+        bound_delta = max(abs(source_bounds[edge][axis] - joined_bounds[edge][axis])
+                          for edge in ("min", "max") for axis in range(3))
+        status = "PASS" if joined_vertices == source_vertices and joined_faces == source_faces and bound_delta <= 1e-5 else "FAIL"
+        result = {
+            "assetRoot": root.name,
+            "batchParent": parent.name,
+            "batchName": active.name,
+            "material": material.name,
+            "sourceMeshCount": len(source_records),
+            "sourceNames": [record["name"] for record in source_records],
+            "sourceVertices": source_vertices,
+            "joinedVertices": joined_vertices,
+            "sourceFaces": source_faces,
+            "joinedFaces": joined_faces,
+            "sourceWorldBounds": source_bounds,
+            "joinedWorldBounds": joined_bounds,
+            "maxWorldBoundsDelta": bound_delta,
+            "geometryPreservation": status,
+        }
+        fixture_batch_results.append(result)
+        results.append(result)
+        if status != "PASS":
+            raise RuntimeError(f"Fixture static batch changed geometry: {json.dumps(result)}")
+    return {"assetRoot": root.name, "candidateMeshCount": len(candidates), "batchCount": len(results)}
