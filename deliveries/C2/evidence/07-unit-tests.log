[31m+     "sections": [[39m
[31m+       {[39m
[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "Generative image models frequently produce convincing macro-level compositions while leaving subtle micro-texture irregularities, pixel correlation shifts, and boundary artifacts across spatial domains.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "text": "Traditional deep learning forensic detectors often overfit to specific generator architectures and require heavy GPU runtimes for inference. This project sought a transparent, lightweight, CPU-runnable classifier that operates directly on interpretable spatial texture statistics rather than opaque neural embeddings.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+         ],[39m
[31m+         "heading": "Forensic Challenge & Motivation",[39m
[31m+         "id": "challenge",[39m
[31m+       },[39m
[31m+       {[39m
[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "The extraction pipeline combines two complementary structural texture descriptors to capture both fine-grained roughness and broader spatial pixel relationships:",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "items": [[39m
[31m+               "Local Binary Patterns (LBP): Computes circular neighborhood comparisons (P=8, R=1) to capture micro-edge distributions and high-frequency noise typical of generative upscalers.",[39m
[31m+               "Gray-Level Co-occurrence Matrix (GLCM): Evaluates second-order joint probability distributions of gray-level transitions across multiple orientations (0°, 45°, 90°, 135°), extracting contrast, dissimilarity, homogeneity, energy, and correlation.",[39m
[31m+               "Illumination Invariance: Normalizes input images prior to matrix computation to prevent ambient lighting gradients from confounding textural feature calculation.",[39m
[31m+             ],[39m
[31m+             "type": "list",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "language": "python",[39m
[31m+             "text": "# Illustrative feature extraction pipeline snippet[39m
[31m+ import cv2[39m
[31m+ from skimage.feature import local_binary_pattern, graycomatrix, graycoprops[39m
[31m+[39m
[31m+ def extract_texture_vector(image_gray):[39m
[31m+     lbp = local_binary_pattern(image_gray, P=8, R=1, method='uniform')[39m
[31m+     lbp_hist, _ = np.histogram(lbp.ravel(), bins=10, range=(0, 10), density=True)[39m
[31m+     glcm = graycomatrix(image_gray, distances=[1], angles=[0, np.pi/4, np.pi/2, 3*np.pi/4], symmetric=True, normed=True)[39m
[31m+     contrast = graycoprops(glcm, 'contrast').mean()[39m
[31m+     homogeneity = graycoprops(glcm, 'homogeneity').mean()[39m
[31m+     energy = graycoprops(glcm, 'energy').mean()[39m
[31m+     correlation = graycoprops(glcm, 'correlation').mean()[39m
[31m+     return np.hstack([lbp_hist, [contrast, homogeneity, energy, correlation]])",[39m
[31m+             "type": "code",[39m
[31m+           },[39m
[31m+         ],[39m
[31m+         "heading": "Texture Feature Extraction Pipeline",[39m
[31m+         "id": "feature-engineering",[39m
[31m+       },[39m
