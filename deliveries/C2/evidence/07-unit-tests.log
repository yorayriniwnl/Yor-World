[31m+     "sections": [[39m
[31m+       {[39m
[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "Residential and commercial rooftop solar planning typically requires expensive specialized CAD modeling or on-site engineering surveys. Property owners lack accessible tools to quickly visualize panel arrangements, understand seasonal yield variation, and calculate capital payback timelines.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "text": "Yor Zenith delivers an integrated browser-based workflow bridging spatial layout and investment decision-making in one interface.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+         ],[39m
[31m+         "heading": "Solar Feasibility Decision Support",[39m
[31m+         "id": "domain-context",[39m
[31m+       },[39m
[31m+       {[39m
[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "The frontend provides a real-time 3D workspace authored with Three.js and React. Users configure parametric roof dimensions, pitch angles, azimuth orientation, and perimeter setbacks.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "items": [[39m
[31m+               "Interactive raycasting to test solar module grid arrangements and surface fit.",[39m
[31m+               "Obstacle boundary definition for roof vents, chimneys, and skylights.",[39m
[31m+               "Real-time visual shadow direction cues based on solar elevation angles.",[39m
[31m+             ],[39m
[31m+             "type": "list",[39m
[31m+           },[39m
[31m+         ],[39m
[31m+         "heading": "3D Spatial Modeling & Panel Placement",[39m
[31m+         "id": "spatial-engine",[39m
[31m+       },[39m
[31m+       {[39m
[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "The simulation engine models seasonal incident solar energy based on geographical latitude, roof tilt, and compass orientation:",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "language": "typescript",[39m
[31m+             "text": "// Mathematical solar irradiance estimation model[39m
[31m+ export function calculateSolarYield(params: {[39m
[31m+   panelCapacityKw: number;[39m
[31m+   tiltDegrees: number;[39m
[31m+   azimuthDegrees: number;[39m
[31m+   annualSunHours: number;[39m
[31m+   systemEfficiency: number;[39m
[31m+ }): { annualKwh: number; monthlyDistribution: number[] } {[39m
[31m+   const orientationFactor = Math.cos((params.azimuthDegrees - 180) * (Math.PI / 180)) * 0.15 + 0.85;[39m
[31m+   const tiltFactor = Math.cos((params.tiltDegrees - 25) * (Math.PI / 180)) * 0.10 + 0.90;[39m
[31m+   const annualKwh = params.panelCapacityKw * params.annualSunHours * params.systemEfficiency * orientationFactor * tiltFactor;[39m
[31m+   // Monthly irradiance distribution coefficients[39m
[31m+   const weights = [0.06, 0.07, 0.09, 0.10, 0.11, 0.11, 0.10, 0.09, 0.09, 0.08, 0.05, 0.05];[39m
[31m+   return { annualKwh: Math.round(annualKwh), monthlyDistribution: weights.map(w => Math.round(annualKwh * w)) };[39m
[31m+ }",[39m
[31m+             "type": "code",[39m
[31m+           },[39m
[31m+           {[39m
[31m+             "text": "Financial modeling factors in gross equipment cost, estimated national/state clean energy subsidies, electricity tariff savings, and projected investment payback periods.",[39m
[31m+             "type": "paragraph",[39m
[31m+           },[39m
