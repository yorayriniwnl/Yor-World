[31m+         "blocks": [[39m
[31m+           {[39m
[31m+             "text": "The irradiance model uses trigonometric solar path equations rather than high-resolution satellite LIDAR point clouds. Financial projections use user-configurable utility rate presets rather than live dynamic utility billing API feeds.",[39m
[31m+             "type": "paragraph",[39m
