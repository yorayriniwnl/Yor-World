# RC3 source and evidence use canonical LF bytes across Windows and CI.
app/** text=auto eol=lf
app/**/*.glb -text
app/**/*.png -text
app/**/*.jpg -text
scripts/release/** text=auto eol=lf
deliveries/G6/full-stack-integration/** text=auto eol=lf
deliveries/G6/full-stack-integration/*.tar.gz -text
# Supplemental probes/text use LF; preserve raw UTF-16 PowerShell logs byte-for-byte.
deliveries/G6/rc3-supplemental-codex-verification/** text=auto eol=lf
deliveries/G6/rc3-supplemental-codex-verification/evidence/*.log -text
